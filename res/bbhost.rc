// The Windows exe's icon and version details. Explorer shows the first icon;
// SDL gives its windows (the setup window and the game's) the same one.
#include "bbhost_version.h"

1 ICON "bbhost.ico"

// VS_VERSION_INFO, VOS_NT_WINDOWS32 and VFT_APP from winver.h.
1 VERSIONINFO
FILEVERSION BBHOST_VERSION_NUMBERS,0
PRODUCTVERSION BBHOST_VERSION_NUMBERS,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#if defined(BBHOST_BBGOATED)
            VALUE "FileDescription", "bbgoated"
            VALUE "ProductName", "bbgoated"
#else
            VALUE "FileDescription", "bbhost"
            VALUE "ProductName", "bbhost"
#endif
            VALUE "FileVersion", BBHOST_VERSION
            VALUE "ProductVersion", BBHOST_VERSION
#if defined(BBHOST_BBGOATED)
            VALUE "InternalName", "bbgoated"
            VALUE "OriginalFilename", "bbgoated.exe"
#else
            VALUE "InternalName", "bbhost"
            VALUE "OriginalFilename", "bbhost.exe"
#endif
            VALUE "LegalCopyright", "GNU General Public License, version 3 or later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
